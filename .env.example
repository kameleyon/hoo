# Copy to .env.local for local development. Never commit a filled-in copy —
# this repository is public.
#
# On Vercel, add these as *sensitive* environment variables so the values are
# write-only and never appear in logs or the dashboard:
# https://vercel.com/docs/environment-variables/sensitive-environment-variables

# Stripe. Prefer a restricted key (rk_...) scoped to Checkout Sessions,
# PaymentIntents and Subscriptions over a full secret key (sk_...).
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# From the webhook endpoint you create in the Stripe dashboard, or from
# `stripe listen` when developing locally.
STRIPE_WEBHOOK_SECRET=

# Recurring Price IDs for Haus of Oracle Pro. Create one Product with two
# Prices (monthly $6.99, yearly $49) and paste the price_... ids here.
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=

# Used to build Checkout redirect URLs. Falls back to the request origin.
NEXT_PUBLIC_SITE_URL=

# Writing the readings. Not wired up yet — see lib/fulfilment.ts.
OPENROUTER_API_KEY=
