# Copy to .env.local for local development. Never commit a filled-in copy —
# this repository is public.
#
# On Vercel, add these as *sensitive* environment variables so the values are
# write-only and never appear in logs or the dashboard:
# https://vercel.com/docs/environment-variables/sensitive-environment-variables

# Stripe. Prefer a restricted key (rk_...) scoped to Checkout Sessions,
# PaymentIntents and Subscriptions over a full secret key (sk_...).
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# From the webhook endpoint you create in the Stripe dashboard, or from
# `stripe listen` when developing locally.
STRIPE_WEBHOOK_SECRET=

# Pro prices need no variable here: run `npm run stripe:setup` once per Stripe
# account and the app resolves them by lookup key.

# Used to build Checkout redirect URLs. Falls back to the request origin.
NEXT_PUBLIC_SITE_URL=

# Supabase. The publishable key is meant for the browser; the secret key must
# never be NEXT_PUBLIC_ and must never reach client code — it bypasses RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Auth email. Supabase sends magic links through Resend SMTP so they come from
# our own verified domain — the built-in sender is capped at a couple of emails
# an hour and is not for production. Configured in supabase/config.toml; the CLI
# reads this variable when running `npm run config:push`.
RESEND_API_KEY=

# Reading lessons aloud, from the editor. Without it the "Read aloud" button
# returns a clear 503 rather than failing silently.
LEMONFOX_API_KEY=

# Writing the readings. Not wired up yet — see lib/fulfilment.ts.
OPENROUTER_API_KEY=
