# The working copy of the Claude Design project. Only the card database is kept,
# because scripts/build-card-data.mjs regenerates lib/data/*.json from it.
.design-src/*
!.design-src/cardData.js

# Source material: the CSVs and OCR text are small and worth versioning, the
# scanned books are 32 MB and belong to someone else. They stay on disk and out
# of a public repository.
lib/data/sources/*.pdf
lib/data/sources/*.PDF
lib/data/sources/*.png
lib/data/sources/*.PNG
lib/data/sources/*.jpg
lib/data/sources/*.jpeg

# OCR of published books (AC15 Composite & Relationship Cards, Sacred Symbols
# of the Ancients). They stay on disk so the tables can be extracted from them;
# the prose itself is someone else's and does not belong in a public repository.
lib/data/sources/*ocr*.txt
lib/data/sources/AC15relationshipcard.txt
lib/data/sources/cardgrid.txt
lib/data/sources/sacredsymbol.txt
